      "type": "text", "version": 1, "id": "note-bridge",
      "x": 700, "y": 360, "width": 240, "height": 60,
      "text": "Bridge only job:\n1. Get Managed Identity token\n2. Forward task via A2A v1.0\n3. Return response to Cowork",
      "fontSize": 12, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top",
      "containerId": null, "originalText": "Bridge only job:\n1. Get Managed Identity token\n2. Forward task via A2A v1.0\n3. Return response to Cowork",
      "autoResize": true, "strokeColor": "#d9480f", "opacity": 100, "angle": 0
    },

