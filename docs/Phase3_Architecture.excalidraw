    {
      "type": "text", "version": 1, "id": "note-skill",
      "x": 700, "y": 130, "width": 240, "height": 80,
      "text": "SKILL.md classifies intent:\n• READ-ONLY → no commit\n• DIRECT COMMIT → straight to branch\n• BRANCH+PR → code change flow\n• EXPLICIT OVERRIDE → user wins",
      "fontSize": 12, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top",
      "containerId": null, "originalText": "SKILL.md classifies intent:\n• READ-ONLY → no commit\n• DIRECT COMMIT → straight to branch\n• BRANCH+PR → code change flow\n• EXPLICIT OVERRIDE → user wins",
      "autoResize": true, "strokeColor": "#e67700", "opacity": 100, "angle": 0
    },

